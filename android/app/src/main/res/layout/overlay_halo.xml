<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#9910172A">
    <LinearLayout
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="34dp"
        android:paddingVertical="36dp"
        android:background="@drawable/bg_halo_card">
        <TextView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="🧠"
            android:background="@drawable/bg_halo_icon"
            android:textSize="34sp"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center"/>
        <TextView
            android:id="@+id/haloTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Halo!"
            android:textAlignment="center"
            android:textStyle="bold"
            android:textSize="28sp"
            android:layout_marginTop="12dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#DDDDDD"/>
        <TextView
            android:id="@+id/haloLighter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sebelum lanjut, lu bakal ngerjain quiz singkat buat bantu otak lu balik fokus."
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textSize="16sp"
            android:textStyle="italic"/>
        <TextView
            android:id="@+id/haloAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:textColor="#6B7280"
            android:textSize="14sp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#DDDDDD"/>
        <TextView
            android:id="@+id/haloMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sebelum lanjut, lu bakal ngerjain quiz singkat buat bantu otak lu balik fokus."
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="#6B7280"
            android:textSize="15sp"/>
        <Button
            android:background="@drawable/bg_continue_button"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textAllCaps="false"
            android:layout_marginTop="28dp"
            android:id="@+id/continueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lanjut ke Quiz"/>
    </LinearLayout>
</FrameLayout>
